# /etc/uii/pimod.env — module agent configuration for the real Pi.
# Variable names are IDENTICAL to the legacy serial_mqtt_gateway where they
# overlap (ANALYTE, PORT_A/PORT_B/BAUD, ADC_*) — copy your current values.

# --- identity -------------------------------------------------------------
UII_MODULE_ID=nh4mod-01
UII_SLOT=slot-1
UII_SERIAL=NH4MOD-FIELD-0001
ANALYTE=NH4

# --- hub (same Pi by default) ----------------------------------------------
UII_HUB=127.0.0.1:7300

# --- hardware — same wiring as today ----------------------------------------
UII_SIM=0
UII_SPEED=1            # MUST stay 1 on real hardware
PORT_A=/dev/ttyUSB0    # PLC (controller)
PORT_B=/dev/ttyUSB1    # pump controller (EZ-stepper)
BAUD=9600
ADC_ENABLED=1
ADC_GAIN=1
ADC_CHANNEL=0
DIVIDER_RATIO=1.0
SHUNT_OHMS=250.0
SIGNAL_MODE=voltage    # or current_4_20
